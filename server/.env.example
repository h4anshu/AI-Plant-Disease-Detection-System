MONGODB_URI=your_mongodb_connection_string_here
PORT=4000
JWT_SECRET=your_jwt_secret_here
FASTAPI_URL=http://localhost:8000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Required when NODE_ENV=production (set in the Dockerfile); optional locally
# Comma-separated browser origins allowed by CORS; unset = any origin (local dev only)
CLIENT_ORIGINS=https://ai-plant-disease-detection-system.vercel.app
# Shared secret sent to the ML service as X-ML-Token; must equal ML_SERVICE_TOKEN on the ML service
ML_SERVICE_TOKEN=long_random_string

# Optional: field health from space (docs/FIELD_HEALTH.md). Unset = the feature answers 503.
GEO_SERVICE_URL=http://localhost:8020
# Shared secret sent as X-Geo-Token; must equal GEO_SERVICE_TOKEN on the geo-service
GEO_SERVICE_TOKEN=long_random_string

# Optional rate limits per IP (defaults shown): predictions per 10 minutes, all requests per 15 minutes
PREDICT_RATE_LIMIT=20
GLOBAL_RATE_LIMIT=300
# Weather-risk lookups per 10 minutes (docs/DISEASE_RISK.md)
RISK_RATE_LIMIT=60
# PDF reports per 10 minutes (docs/REPORT.md)
REPORT_RATE_LIMIT=20
# Optional: map tiles for the report (default https://tile.openstreetmap.org/{z}/{x}/{y}.png)
# OSM_TILE_URL=
# Optional: a diagonal watermark on every report (only for samples/demos)
# REPORT_WATERMARK=
# Optional: Open-Meteo endpoint (default https://api.open-meteo.com/v1/forecast; free, no key, non-commercial)
# OPEN_METEO_URL=
# Optional: official warnings (docs/FIELD_ALERTS.md section 7). Do not fetch these sources: sachet, imd, or both (kill switch)
# ALERTS_DISABLED_SOURCES=
# Optional: secret for GET /api/alerts/health and POST /api/alerts/tick (header x-alerts-token); unset = both answer 503
# ALERTS_ADMIN_TOKEN=long_random_string
# Optional: weather-alert calls per 10 minutes (default 60)
# ALERT_RATE_LIMIT=60
# Optional: more kill switches for ALERTS_DISABLED_SOURCES: glofas (river-flow signal), cwc (river gauges); see docs/FIELD_ALERTS.md section 8
# Optional: the news card's headlines can be switched off with the kill switch "news" in ALERTS_DISABLED_SOURCES; see docs/FIELD_ALERTS.md section 10
# Optional: NASA FIRMS key for the fire-near-the-field alert (free, firms.modaps.eosdis.nasa.gov/api/area/); server side only. Without it the fire check is off. Switch: "fire" in ALERTS_DISABLED_SOURCES
# FIRMS_MAP_KEY=
# Optional, for tests: FIRMS_URL
# Optional: data.gov.in key for the mandi-price card (free, data.gov.in, "Generate API Key" on the dataset page); server side only. Without it the card is off. Switch: "mandi" in ALERTS_DISABLED_SOURCES
# DATA_GOV_API_KEY=
